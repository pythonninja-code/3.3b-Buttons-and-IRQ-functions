#This code snippet will make the LED strip light up for two seconds
#You may need to change the number of pixels on line 9
#If you wired your Pico to a different pin as described in guide 33b, you may need to change the '28' pin value on line 10 (numpix, 0, 28, "GRB")

from machine import Pin
import time
from neopixel import Neopixel

numpix = 50
strip = Neopixel(numpix, 0, 28, "GRB")
red = (255, 0, 0)
blank = (0,0,0)

strip.fill(red)
strip.show()
time.sleep(2)
strip.fill(blank)
strip.show()
