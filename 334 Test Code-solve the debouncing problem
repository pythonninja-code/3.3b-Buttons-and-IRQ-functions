#Test code exploring the problem of debouncing
#Deboucing is when you get multiple readings from button presses

from machine import Pin
import time
#button variable
button = Pin(15, Pin.IN, Pin.PULL_UP)
#On-Board LED
led_pin = Pin(25, Pin.OUT)

#commands
def pir_interrupt(pin):
    if pin.value() == 0:
        print("button pressed")


# This command listens for the button press
button.irq(trigger=(Pin.IRQ_FALLING), handler=pir_interrupt)

# This is an endless while loop
while True:
    print("looping")
    time.sleep(1)
    
